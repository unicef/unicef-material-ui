{
  "name": "@unicef/material-ui",
  "version": "3.0.0",
  "description": "UNICEF theme and components of material-ui for react",
  "type": "module",
  "main": "./lib/prod.cjs",
  "module": "./lib/prod.js",
  "exports": {
    "import": "./lib/prod.js",
    "require": "./lib/prod.cjs"
  },
  "files": [
    "lib",
    "dist"
  ],
  "homepage": "https://unicef.github.io/unicef-material-ui",
  "scripts": {
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "cross-env NODE_ENV=development rollup -c",
    "build:prod": "cross-env NODE_ENV=production rollup -c",
    "build:example": "npm run build:prod && rm -rf gh-pages-build/* && cd example && npm run build && cp -R build/* ../gh-pages-build/",
    "build:site": "npm run build:prod && npm run build:docs && rm -rf site && mkdir -p site/example && cp -R ./styleguide/* ./site/ && cd example && npm ci && npm run build && cp -R dist/* ../site/example/",
    "start": "rollup -c -w",
    "docs": "styleguidist server --config styleguide.config.cjs",
    "build:docs": "styleguidist build --config styleguide.config.cjs",
    "transpile": "npm run build",
    "prepublishOnly": "npm run transpile",
    "deploy": "npm run build:site && gh-pages -d site",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unicef/unicef-material-ui.git"
  },
  "author": "unicef",
  "license": "GPL-3.0-or-later",
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "dayjs": ">=1.11.21",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "bugs": {
    "url": "https://github.com/unicef/unicef-material-ui/issues"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!<rootDir>/node_modules/"
    ],
    "coverageReporters": [
      "text"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-external-helpers": "^7.26.0",
    "@babel/plugin-transform-react-jsx": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@rollup/plugin-babel": "^6.0.7",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^5.0.7",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-styleguidist": "^13.1.4",
    "rollup": "^4.27.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.96.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "react-form-validator-core": "^2.0.2",
    "react-number-format": "^5.5.0"
  }
}
